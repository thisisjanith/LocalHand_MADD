# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection strings from Supabase (Connect -> ORM -> Prisma).
# DATABASE_URL uses the transaction-mode pooler (port 6543) for the app's
# normal short-lived queries. DIRECT_URL uses the session-mode pooler (port
# 5432) and is only used by Prisma for migrations, which need a session-level
# connection the transaction pooler can't provide.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres"

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# How long an access token stays valid.
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (S3-compatible). From the Cloudflare dashboard: R2 -> Manage
# R2 API Tokens -> create a token with Object Read & Write.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="localhand-photos"
# The bucket's public URL — either R2's own r2.dev subdomain (Settings ->
# Public Access -> enable) or a custom domain you've connected to the bucket.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Gemini API key (Google AI Studio -> Get API key). Powers the in-app
# assistant's chat replies and real-listing lookups via function calling.
GEMINI_API_KEY="your-gemini-api-key"

# A single hardcoded credential for the admin dashboard (LocalHand_Admin) —
# not a User row, checked directly against these env vars in POST /admin/login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

PORT=3000

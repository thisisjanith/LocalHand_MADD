<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lh_screen_padding"
        android:paddingEnd="@dimen/lh_screen_padding">

        <FrameLayout
            android:id="@+id/btn_back_frame"
            android:layout_width="@dimen/lh_min_touch_target"
            android:layout_height="@dimen/lh_min_touch_target"
            android:layout_marginTop="@dimen/lh_gap_small">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/lh_text"
                android:scaleType="center"
                android:contentDescription="@string/cd_back" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="@dimen/lh_avatar_large"
                android:layout_height="@dimen/lh_avatar_large"
                android:background="@drawable/bg_circle_accent">

                <TextView
                    android:id="@+id/tv_avatar_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/Lh.Text.SectionHeading"
                    android:textColor="@color/lh_on_accent"
                    tools:text="S" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lh_gap"
                android:textAppearance="@style/Lh.Text.ScreenTitle"
                tools:text="Sadev Bandara" />

            <TextView
                android:id="@+id/tv_locality_since"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lh_gap_tiny"
                android:gravity="center"
                android:textAppearance="@style/Lh.Text.Label"
                tools:text="Ginigathhena · member since 2024" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_listings"
                layout="@layout/view_stat_tile" />

            <View
                android:layout_width="@dimen/lh_gap"
                android:layout_height="1dp" />

            <include
                android:id="@+id/stat_rating"
                layout="@layout/view_stat_tile" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:layout_marginBottom="@dimen/lh_gap"
            android:text="@string/label_listings"
            android:textAppearance="@style/Lh.Text.SectionHeading" />

        <TextView
            android:id="@+id/tv_no_listings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lh_gap"
            android:text="@string/provider_empty_listings"
            android:textAppearance="@style/Lh.Text.Body"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_listings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lh_section_gap"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_listing_row" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

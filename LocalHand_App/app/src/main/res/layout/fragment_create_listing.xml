<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lh_screen_padding"
        android:paddingEnd="@dimen/lh_screen_padding"
        android:paddingBottom="@dimen/lh_section_gap">

        <include
            android:id="@+id/screen_header"
            layout="@layout/view_screen_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_small"
            app:singleSelection="true"
            app:selectionRequired="true">

            <Button
                android:id="@+id/btn_type_service"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_service"
                android:textAppearance="@style/Lh.Text.Button" />

            <Button
                android:id="@+id/btn_type_marketplace"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_marketplace"
                android:textAppearance="@style/Lh.Text.Button" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_title"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:hint="@string/hint_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_category"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:hint="@string/hint_category"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actv_category"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_price"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:hint="@string/hint_rate">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_price"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_condition"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:hint="@string/hint_condition"
            android:visibility="gone"
            tools:visibility="visible"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actv_condition"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_locality"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:hint="@string/hint_area">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_locality"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.example.localhand_new.ui.views.MapPinPicker
            android:id="@+id/map_pin_picker"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lh_map_height"
            android:layout_marginTop="@dimen/lh_gap" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            style="@style/Lh.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:hint="@string/label_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:minLines="4"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_large"
            android:text="@string/label_photos"
            android:textAppearance="@style/Lh.Text.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/photos_helper_text"
            android:textAppearance="@style/Lh.Text.Label"
            android:textColor="@color/lh_faint" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lh_photo_thumb_size"
            android:layout_marginTop="@dimen/lh_gap_nudge"
            android:clipToPadding="false"
            android:orientation="horizontal"
            tools:listitem="@layout/item_listing_photo" />

        <Button
            android:id="@+id/btn_post_listing"
            style="@style/Lh.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:text="@string/action_post_listing" />

    </LinearLayout>
</ScrollView>

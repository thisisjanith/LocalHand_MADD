<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lh_screen_padding"
        android:paddingEnd="@dimen/lh_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="@dimen/lh_avatar_large"
                android:layout_height="@dimen/lh_avatar_large"
                android:background="@drawable/bg_circle_accent">

                <TextView
                    android:id="@+id/tv_avatar_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/Lh.Text.SectionHeading"
                    android:textColor="@color/lh_on_accent"
                    tools:text="N" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lh_gap"
                android:textAppearance="@style/Lh.Text.ScreenTitle"
                tools:text="Nimasha Kodikara" />

            <TextView
                android:id="@+id/tv_locality_since"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lh_gap_tiny"
                android:gravity="center"
                android:textAppearance="@style/Lh.Text.Label"
                tools:text="Kaduwela Road · member since 2024" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_listings"
                layout="@layout/view_stat_tile" />

            <View
                android:layout_width="@dimen/lh_gap"
                android:layout_height="1dp" />

            <include
                android:id="@+id/stat_favourites"
                layout="@layout/view_stat_tile" />

            <View
                android:layout_width="@dimen/lh_gap"
                android:layout_height="1dp" />

            <include
                android:id="@+id/stat_rating"
                layout="@layout/view_stat_tile" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_favourites"
            style="@style/Lh.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/lh_gap_large">

                <ImageView
                    android:layout_width="@dimen/lh_icon_size"
                    android:layout_height="@dimen/lh_icon_size"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/lh_danger"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/lh_gap"
                    android:text="@string/label_favourites"
                    android:textAppearance="@style/Lh.Text.CardTitle" />

                <TextView
                    android:id="@+id/tv_favourite_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Lh.Text.Label"
                    android:textColor="@color/lh_faint"
                    tools:text="3 saved" />

                <ImageView
                    android:layout_width="@dimen/lh_icon_size"
                    android:layout_height="@dimen/lh_icon_size"
                    android:layout_marginStart="@dimen/lh_gap_tiny"
                    android:src="@drawable/ic_keyboard_arrow_right"
                    app:tint="@color/lh_faint"
                    android:contentDescription="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_section_gap"
            android:layout_marginBottom="@dimen/lh_gap"
            android:text="@string/label_my_listings"
            android:textAppearance="@style/Lh.Text.SectionHeading" />

        <TextView
            android:id="@+id/tv_no_listings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lh_gap"
            android:text="@string/profile_empty_listings"
            android:textAppearance="@style/Lh.Text.Body"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_my_listings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_listing_row" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Lh.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lh_gap_large"
                android:paddingEnd="@dimen/lh_gap"
                android:paddingTop="@dimen/lh_gap_small"
                android:paddingBottom="@dimen/lh_gap_small">

                <ImageView
                    android:layout_width="@dimen/lh_icon_size"
                    android:layout_height="@dimen/lh_icon_size"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/lh_muted"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/lh_gap"
                    android:text="@string/label_dark_mode"
                    android:textAppearance="@style/Lh.Text.CardTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dark_mode"
                    style="@style/Lh.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sign_out"
            style="@style/Lh.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap"
            android:layout_marginBottom="@dimen/lh_nav_bar_height"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/lh_gap_large">

                <ImageView
                    android:layout_width="@dimen/lh_icon_size"
                    android:layout_height="@dimen/lh_icon_size"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/lh_danger"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lh_gap"
                    android:text="@string/action_sign_out"
                    android:textAppearance="@style/Lh.Text.CardTitle"
                    android:textColor="@color/lh_danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

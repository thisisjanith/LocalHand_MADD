<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    style="@style/Lh.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/lh_gap_large"
        android:paddingBottom="@dimen/lh_gap_large">

        <TextView
            android:id="@+id/tile_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lh.Text.ScreenTitle"
            android:textColor="@color/lh_accent"
            tools:text="6" />

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lh_gap_tiny"
            android:textAppearance="@style/Lh.Text.Label"
            tools:text="Listings" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/lh_gap_small"
        android:paddingEnd="@dimen/lh_gap_small"
        android:paddingTop="@dimen/lh_gap_small"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/lh_min_touch_target"
            android:layout_height="@dimen/lh_min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="center"
            android:contentDescription="@string/cd_back" />

        <FrameLayout
            android:layout_width="@dimen/lh_avatar_small"
            android:layout_height="@dimen/lh_avatar_small"
            android:background="@drawable/bg_circle_accent_wash">

            <ImageView
                android:layout_width="@dimen/lh_icon_size_small"
                android:layout_height="@dimen/lh_icon_size_small"
                android:layout_gravity="center"
                android:src="@drawable/ic_auto_awesome"
                app:tint="@color/lh_accent"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lh_gap_small"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_title"
                android:textAppearance="@style/Lh.Text.CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_subtitle"
                android:textAppearance="@style/Lh.Text.Label" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/lh_screen_padding"
        android:paddingEnd="@dimen/lh_screen_padding"
        android:paddingTop="@dimen/lh_gap"
        android:paddingBottom="@dimen/lh_gap"
        tools:listitem="@layout/item_message_bubble" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/lh_gap"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/suggestion_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/lh_screen_padding"
            android:paddingEnd="@dimen/lh_screen_padding" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/lh_screen_padding"
        android:paddingEnd="@dimen/lh_screen_padding"
        android:paddingBottom="@dimen/lh_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input"
            style="@style/Lh.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxCornerRadiusBottomStart="100dp"
            app:boxCornerRadiusBottomEnd="100dp"
            app:boxCornerRadiusTopStart="100dp"
            app:boxCornerRadiusTopEnd="100dp"
            android:hint="@string/hint_ask_anything">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_input"
                style="@style/Lh.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:id="@+id/btn_send_frame"
            android:layout_width="@dimen/lh_min_touch_target"
            android:layout_height="@dimen/lh_min_touch_target"
            android:layout_marginStart="@dimen/lh_gap_small"
            android:background="@drawable/bg_circle_accent">

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_send"
                app:tint="@color/lh_on_accent"
                android:scaleType="center"
                android:contentDescription="@string/cd_send" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>

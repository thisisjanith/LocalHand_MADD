<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext (plain HTTP) traffic to the Android emulator's dev-backend
  alias only — API 28+ blocks cleartext by default. Scoped to this one host
  rather than a blanket usesCleartextTraffic="true", so swapping BASE_URL in
  app/build.gradle.kts to a deployed https:// Render URL later doesn't leave
  cleartext permitted everywhere else. If testing against a physical device on
  the same LAN (a real IP instead of 10.0.2.2), add a matching <domain> entry
  here for that IP at that time.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
